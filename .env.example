# ==========================================================
# SYNTHETIC BANK: Environment Configuration Example
# Copy this file to .env to override defaults in local/Docker
# ==========================================================

# Security & JWT Token Config
SECRET_KEY=replace-with-a-random-secret-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend & CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Frontend Proxy Target (Inside Docker network, Next.js calls backend:8000)
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_URL=/api

# Custom Data & Database Paths (Optional - defaults to project relative paths)
# CANONICAL_DATASET_PATH=/app/CLEANED DATA/FINAL_DS.csv
# MODELS_DIR=/app/synthetic_bank/models
# SYNTHETIC_DB_PATH=/app/synthetic_bank/synthetic_bank.db
# SYNTHETIC_OUTPUTS_DIR=/app/synthetic_bank/synthetic_bank_outputs
# AUTH_DB_PATH=/app/backend/auth.db
